# Optional AI recipe builder. Pick a provider and set its key.
SCRAPER_AI_PROVIDER=groq            # groq | anthropic
GROQ_API_KEY=
# SCRAPER_GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
# SCRAPER_CLAUDE_MODEL=claude-opus-5-5
# Max characters of page HTML sent to the model (default 11000 for Groq's free tier, 60000 for Claude)
# SCRAPER_AI_PROMPT_CHARS=11000

# SCRAPER_MIN_DELAY=2
# SCRAPER_MAX_DELAY=5
# SCRAPER_MAX_PAGES=10
# SCRAPER_CACHE_TTL_HOURS=24
# SCRAPER_MAX_JOBS=2                 # jobs that crawl at the same time; the rest wait in the queue

# ---- Security (see SECURITY.md) ----
# SCRAPER_ALLOW_HOSTS=                 # hosts allowed although they resolve to a local/private address
# SCRAPER_BLOCKED_DOMAINS=             # comma-separated do-not-scrape list
# SCRAPER_DAILY_BUDGET=500             # pages per site per day
# SCRAPER_DAILY_BUDGET_LOGGED_IN=200   # pages per site per day when logged in
# SCRAPER_COOLDOWN_MINUTES=60          # pause after 429 / repeated challenges
# SCRAPER_SESSION_MAX_AGE_DAYS=7       # saved logins expire after this
# SCRAPER_JOB_RETENTION_DAYS=30        # finished jobs are deleted after this unless kept
# SCRAPER_CONTACT=you@example.com      # used by the optional honest user agent
