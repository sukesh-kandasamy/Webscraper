#!/bin/sh
# Block commits that contain API keys, cookies, .env, databases or session files.
# Enabled with:  git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
if [ -x "$ROOT/.venv/Scripts/python.exe" ]; then PY="$ROOT/.venv/Scripts/python.exe"
elif [ -x "$ROOT/.venv/bin/python" ]; then PY="$ROOT/.venv/bin/python"
else PY="python"; fi
exec "$PY" "$ROOT/tools/secret_scan.py" --staged
